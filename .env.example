APP_MODE=demo
PUBLIC_BASE_URL=http://127.0.0.1:5173
DATABASE_URL=sqlite:///./fsp_signal.db
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=demo@example.test
SESSION_SECURE=false
FSP_PROVIDER=mock

# Optional external AI assistant. Keep the API key only in your local .env/secret store.
FRONTIERAI_BASE_URL=https://gateway.frontierai.ru/v1/chat/completions
FRONTIERAI_MODEL=qwen3.8-27b-4a100
FRONTIERAI_API_KEY=
AI_ASSISTANT_MAX_INPUT_CHARS=2000
AI_ASSISTANT_MAX_OUTPUT_TOKENS=800
AI_ASSISTANT_TIMEOUT_SECONDS=30
